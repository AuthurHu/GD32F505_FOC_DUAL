		(uuid "aa71a573-5c15-4993-b26d-2e85e8a8dd00")
	)
	(text "模块电路功能：\n这是一个基于 TPS54560 芯片的DC-DC降压转换器电路。\n核心功能是将一个较高的输入电压VIN高效地转换为稳定的15V直流输出。\n引脚功能：\n该电路EN悬空，采用内置上拉电路，默认开启。\n供电电压范围：\n输入电压：4.5V~60V；\n输出电压：+15V\n应用场景：\n可用于工业自动化与控制 (24V 系统)，车载电子系统 (12V/24V 总线)等。"
		(exclude_from_sim no)
		(at 39.878 346.202 0)
		(effects
			(font
				(face "宋体")
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "e875e033-f7b7-41f9-a55a-2141bce5e1d8")
	)
